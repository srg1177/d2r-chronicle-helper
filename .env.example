# Copy to .env and change what you need. Every value here is optional.

# Port the site is served on: http://localhost:8080
PORT=8080

# Account created the first time the stack starts.
# Changing these later does not change an account that already exists.
DEFAULT_USERNAME=Deckard
DEFAULT_PASSWORD=Cain

# true = the login screen offers "Create Account"
ALLOW_REGISTRATION=true

# How long a login stays valid, in days
SESSION_DAYS=30

# Database password (only used between the containers)
POSTGRES_PASSWORD=chronicle
